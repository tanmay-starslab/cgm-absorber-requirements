[
 {
  "name": "set_instrument",
  "description": "Set the spectrograph and view. R: resolving power per band (one value, or two for the two R cases). snr: S/N per resolution element (one value, or two for the two S/N cases). layout: 1 case, 2 cases varying R, 2 cases varying S/N, or the 2x2 grid. ions: the ions to plot. vhw: half-width of the velocity window (km/s). vc: window centre (km/s). fit: overplot on-the-fly component fits.",
  "input_schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "R": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "uv": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 5000,
         "maximum": 150000
        },
        {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 150000
         },
         "minItems": 2,
         "maxItems": 2
        }
       ]
      },
      "euv": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 5000,
         "maximum": 150000
        },
        {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 150000
         },
         "minItems": 2,
         "maxItems": 2
        }
       ]
      },
      "xray": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 100,
         "maximum": 5000
        },
        {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
         },
         "minItems": 2,
         "maxItems": 2
        }
       ]
      }
     }
    },
    "snr": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 2,
       "maximum": 100
      },
      {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 2,
        "maximum": 100
       },
       "minItems": 2,
       "maxItems": 2
      }
     ]
    },
    "layout": {
     "type": "string",
     "enum": [
      "1",
      "2R",
      "2SN",
      "4"
     ]
    },
    "ions": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "HI",
       "MgII",
       "SiII",
       "CII",
       "SiIII",
       "CIII",
       "SiIV",
       "CIV",
       "NV",
       "OVI",
       "NeVIII",
       "OVII"
      ]
     },
     "minItems": 1,
     "maxItems": 12,
     "uniqueItems": true
    },
    "vhw": {
     "type": "integer",
     "minimum": 10,
     "maximum": 1500
    },
    "vc": {
     "type": "number",
     "minimum": -1500,
     "maximum": 1500
    },
    "fit": {
     "type": "boolean"
    }
   }
  }
 },
 {
  "name": "select_sightline",
  "description": "Show an existing sightline by id (as returned by search_sightlines or request_*).",
  "input_schema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^((face|edge|rand)_b\\d{3}_a\\d{3}(_s\\d+)?|cust_[0-9a-f]{10})$"
    }
   }
  }
 },
 {
  "name": "search_sightlines",
  "description": "Find sightlines by their fitted Voigt components. Returns ranked ids with reasons.",
  "input_schema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "query"
   ],
   "properties": {
    "query": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "ion"
     ],
     "properties": {
      "ion": {
       "type": "string",
       "enum": [
        "HI",
        "MgII",
        "SiII",
        "CII",
        "SiIII",
        "CIII",
        "SiIV",
        "CIV",
        "NV",
        "OVI",
        "NeVIII",
        "OVII"
       ]
      },
      "n_min": {
       "type": "integer",
       "minimum": 0,
       "maximum": 30
      },
      "n_max": {
       "type": "integer",
       "minimum": 0,
       "maximum": 30
      },
      "sep_kms": {
       "type": "array",
       "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 3000
       },
       "minItems": 2,
       "maxItems": 2
      },
      "logN_min": {
       "type": "number",
       "minimum": 10,
       "maximum": 22.5
      },
      "logN_max": {
       "type": "number",
       "minimum": 10,
       "maximum": 22.5
      },
      "b_min": {
       "type": "number",
       "minimum": 0,
       "maximum": 150
      },
      "b_max": {
       "type": "number",
       "minimum": 0,
       "maximum": 150
      },
      "b_kpc": {
       "type": "array",
       "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 400
       },
       "minItems": 2,
       "maxItems": 2
      },
      "orientation": {
       "type": "string",
       "enum": [
        "face-on",
        "edge-on",
        "random",
        "custom"
       ]
      },
      "sort": {
       "type": "string",
       "enum": [
        "score",
        "b_kpc",
        "n"
       ]
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 200
      }
     }
    }
   }
  }
 },
 {
  "name": "request_sightline",
  "description": "Load or generate the sightline with this orientation, impact parameter b (kpc) and azimuth (deg from the projected major axis). seed is required for random orientation.",
  "input_schema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "orientation",
    "b_kpc",
    "azimuth_deg"
   ],
   "properties": {
    "orientation": {
     "type": "string",
     "enum": [
      "face-on",
      "edge-on",
      "random"
     ]
    },
    "b_kpc": {
     "type": "number",
     "minimum": 0,
     "maximum": 300
    },
    "azimuth_deg": {
     "type": "number",
     "minimum": 0,
     "maximum": 360
    },
    "seed": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4294967295
    }
   }
  }
 },
 {
  "name": "request_custom_ray",
  "description": "Generate a straight ray between two points given in kpc relative to the galaxy centre (simulation box axes). |p| <= 395 kpc, length 20-800 kpc.",
  "input_schema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "p0_kpc",
    "p1_kpc"
   ],
   "properties": {
    "p0_kpc": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": -395,
      "maximum": 395
     },
     "minItems": 3,
     "maxItems": 3
    },
    "p1_kpc": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": -395,
      "maximum": 395
     },
     "minItems": 3,
     "maxItems": 3
    }
   }
  }
 },
 {
  "name": "show_3d",
  "description": "Open the 3D tab, optionally choosing the gas field and camera preset.",
  "input_schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "species": {
     "type": "string",
     "enum": [
      "nH",
      "T",
      "Z",
      "HI",
      "MgII",
      "SiII",
      "CII",
      "SiIII",
      "CIII",
      "SiIV",
      "CIV",
      "NV",
      "OVI",
      "NeVIII",
      "OVII"
     ]
    },
    "preset": {
     "type": "string",
     "enum": [
      "face-on",
      "edge-on",
      "sightline"
     ]
    }
   }
  }
 }
]
